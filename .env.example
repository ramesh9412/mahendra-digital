# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing user and admin session tokens.
# Leave unset in local preview for an automatic secure random secret.
SESSION_SECRET=

# ADMIN_USERNAME & ADMIN_PASSCODE: Optional server-side admin credentials.
# If unset, the /admin portal presents a one-time setup form to claim the first admin account.
ADMIN_USERNAME=
ADMIN_PASSCODE=

# PAYMENT_GATEWAY_KEY_ID & PAYMENT_GATEWAY_KEY_SECRET: Optional payment gateway credentials for automated deposit verification.
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
